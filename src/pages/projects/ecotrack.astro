---
import {
  ArrowLeft,
  ArrowUpRight,
  CheckCircle2,
  Code2,
  Database,
  Github,
  MapPin,
  Smartphone,
  Users,
} from "lucide-astro";

import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import { withBase } from "../../utils/site";

const project = projects.find((item) => item.slug === "ecotrack");

if (!project) {
  throw new Error("Projet EcoTrack introuvable.");
}
---

<Layout
  title={`${project.title} | Portfolio Venceslas AGBEMATCHI`}
  description={project.subtitle}
>
  <main>
    <!-- HERO -->

    <section class="project-hero">
      <div class="container">
        <a href={withBase("/projects")} class="back-link">
          <ArrowLeft size={17} />
          Retour aux projets
        </a>

        <div class="project-label">
          {project.status}
        </div>

        <h1>
          {project.title}
        </h1>

        <p class="project-subtitle">
          {project.subtitle}
        </p>

        <div class="hero-tags">
          <span>{project.category}</span>
          <span>{project.year}</span>
        </div>
      </div>
    </section>

    <!-- PROJECT OVERVIEW -->

    <section class="overview-section">
      <div class="container">
        <div class="overview-grid">
          <div class="overview-main">
            <div class="section-eyebrow">
              <span></span>
              LE PROJET
            </div>

            <h2>Une solution numérique au service de l'environnement.</h2>

            <p>
              {project.longDescription}
            </p>
          </div>

          <aside class="project-facts">
            <div class="fact">
              <Smartphone size={20} />

              <div>
                <span>Type</span>
                <strong>Web & Mobile</strong>
              </div>
            </div>

            <div class="fact">
              <MapPin size={20} />

              <div>
                <span>Contexte</span>
                <strong>Bénin</strong>
              </div>
            </div>

            <div class="fact">
              <Users size={20} />

              <div>
                <span>Utilisateurs</span>
                <strong>Multi-rôles</strong>
              </div>
            </div>

            <div class="fact">
              <Database size={20} />

              <div>
                <span>Backend</span>
                <strong>API + MySQL</strong>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- PROBLEM / SOLUTION -->

    <section class="problem-section">
      <div class="container">
        <div class="problem-grid">
          <article>
            <span class="number"> 01 </span>

            <h2>Le problème</h2>

            <p>
              {project.problem}
            </p>
          </article>

          <article>
            <span class="number"> 02 </span>

            <h2>La solution</h2>

            <p>
              {project.solution}
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- FEATURES -->

    <section class="features-section">
      <div class="container">
        <div class="section-header">
          <div class="section-eyebrow">
            <span></span>
            FONCTIONNALITÉS
          </div>

          <h2>Une plateforme pensée autour de plusieurs acteurs.</h2>
        </div>

        <div class="features-grid">
          {
            project.features.map((feature) => (
              <div class="feature">
                <CheckCircle2 size={18} />

                <span>{feature}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ROLES -->

    <section class="roles-section">
      <div class="container">
        <div class="section-header">
          <div class="section-eyebrow">
            <span></span>
            UTILISATEURS
          </div>

          <h2>Une architecture multi-rôles.</h2>
        </div>

        <div class="roles-grid">
          {
            project.roles.map((role) => (
              <article class="role-card">
                <div class="role-icon">
                  <Users size={20} />
                </div>

                <h3>{role.name}</h3>

                <p>{role.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TECHNOLOGIES -->

    <section class="tech-section">
      <div class="container">
        <div class="tech-grid">
          <div>
            <div class="section-eyebrow">
              <span></span>
              TECHNOLOGIES
            </div>

            <h2>Stack technique.</h2>

            <p>
              Une architecture séparant l'application mobile, l'API et la base
              de données.
            </p>
          </div>

          <div class="tech-list">
            {
              project.technologies.map((technology) => (
                <div class="tech-item">
                  <Code2 size={17} />

                  <span>{technology}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE -->

    <section class="architecture-section">
      <div class="container">
        <div class="section-header">
          <div class="section-eyebrow">
            <span></span>
            ARCHITECTURE
          </div>

          <h2>Une architecture organisée par responsabilités.</h2>
        </div>

        <div class="architecture">
          {
            project.architecture.map((item, index) => (
              <div class="architecture-item">
                <span>0{index + 1}</span>

                <strong>{item}</strong>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SCREENSHOTS -->

    <section class="screenshots-section">
      <div class="container">
        <div class="section-header">
          <div class="section-eyebrow">
            <span></span>
            CAPTURES
          </div>

          <h2>EcoTrack en images.</h2>

          <p>
            Découvrez les principaux écrans de l'application et le parcours de
            signalement des incidents.
          </p>
        </div>

        <div class="screenshots-grid">
          {
            project.screenshots.map((screenshot, index) => (
              <figure class:list={{ "screenshot-featured": index === 0 }}>
                <button
                  type="button"
                  class="screenshot-button"
                  data-image={withBase(screenshot.src)}
                  data-alt={screenshot.alt}
                  data-caption={screenshot.caption}
                  aria-label={`Agrandir : ${screenshot.caption}`}
                >
                  <img
                    src={withBase(screenshot.src)}
                    alt={screenshot.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />

                  <span class="zoom-indicator">
                    <ArrowUpRight size={18} />
                  </span>
                </button>

                <figcaption>{screenshot.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->

    <section class="project-cta">
      <div class="container">
        <div class="cta">
          <div>
            <span> ECO TRACK </span>

            <h2>Intéressé par le projet ?</h2>

            <p>
              Explorez le code source ou découvrez les autres projets de mon
              portfolio.
            </p>
          </div>

          <div class="cta-actions">
            {
              project.links.github && (
                <a
                  href={project.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="github-button"
                >
                  <Github size={19} />
                  Voir sur GitHub
                  <ArrowUpRight size={16} />
                </a>
              )
            }

            <a href={withBase("/projects")} class="back-button">
              Tous les projets
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="image-modal" id="image-modal" aria-hidden="true">
      <button
        type="button"
        class="modal-close"
        id="modal-close"
        aria-label="Fermer l'image"
      >
        ×
      </button>

      <div class="modal-content">
        <img id="modal-image" src="" alt="" />

        <p id="modal-caption"></p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .project-hero {
    padding-block: 5rem 6rem;

    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;

    gap: 0.45rem;

    color: var(--color-text-muted);

    font-size: var(--text-sm);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .project-label {
    display: inline-block;

    margin-top: 4rem;

    padding: 0.4rem 0.7rem;

    color: var(--color-primary);

    background: rgba(29, 185, 84, 0.08);

    border: 1px solid rgba(29, 185, 84, 0.15);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: 0.68rem;

    font-weight: 700;
  }

  .project-hero h1 {
    margin-top: 1rem;

    font-size: clamp(4rem, 10vw, 8rem);

    letter-spacing: -0.07em;

    line-height: 0.9;
  }

  .project-subtitle {
    max-width: 800px;

    margin-top: 1.5rem;

    color: var(--color-text-muted);

    font-size: clamp(1.1rem, 2vw, 1.4rem);

    line-height: 1.7;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem;

    margin-top: 2rem;
  }

  .hero-tags span {
    padding: 0.45rem 0.7rem;

    color: var(--color-text-secondary);

    border: 1px solid var(--color-border);

    border-radius: 999px;

    font-size: var(--text-xs);
  }

  .overview-section,
  .problem-section,
  .features-section,
  .roles-section,
  .tech-section,
  .architecture-section,
  .screenshots-section {
    padding-block: var(--space-24);
  }

  .overview-grid {
    display: grid;

    grid-template-columns: 1.2fr 0.8fr;

    gap: var(--space-16);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;

    gap: 0.55rem;

    margin-bottom: 1rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 700;

    letter-spacing: 0.08em;
  }

  .section-eyebrow span {
    width: 24px;
    height: 2px;

    background: var(--color-primary);
  }

  .overview-main h2,
  .section-header h2,
  .tech-grid h2 {
    max-width: 750px;

    font-size: clamp(2rem, 4vw, 3.4rem);

    letter-spacing: -0.045em;

    line-height: 1.05;
  }

  .overview-main p {
    max-width: 750px;

    margin-top: 1.5rem;

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.85;
  }

  .project-facts {
    display: grid;

    gap: 0.75rem;
  }

  .fact {
    display: flex;

    align-items: center;

    gap: 0.9rem;

    padding: 1rem;

    background: var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);
  }

  .fact > svg {
    color: var(--color-primary);
  }

  .fact span {
    display: block;

    color: var(--color-text-muted);

    font-size: 0.7rem;
  }

  .fact strong {
    display: block;

    margin-top: 0.2rem;

    font-size: var(--text-sm);
  }

  .problem-section,
  .roles-section,
  .architecture-section {
    background: var(--color-surface);
  }

  .problem-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 1rem;
  }

  .problem-grid article {
    padding: 2rem;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);
  }

  .number {
    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: 0.75rem;
  }

  .problem-grid h2 {
    margin-top: 2rem;

    font-size: var(--text-2xl);
  }

  .problem-grid p {
    margin-top: 1rem;

    color: var(--color-text-muted);

    line-height: 1.8;
  }

  .section-header {
    max-width: 800px;

    margin-bottom: var(--space-12);
  }

  .section-header p {
    margin-top: 1.2rem;

    color: var(--color-text-muted);

    line-height: 1.7;
  }

  .features-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 0.75rem;
  }

  .feature {
    display: flex;

    gap: 0.65rem;

    align-items: flex-start;

    padding: 1rem;

    background: var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    color: var(--color-text-secondary);

    font-size: var(--text-sm);
  }

  .feature svg {
    flex-shrink: 0;

    color: var(--color-primary);
  }

  .roles-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 1rem;
  }

  .role-card {
    padding: 1.5rem;

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);
  }

  .role-icon {
    display: grid;

    place-items: center;

    width: 42px;
    height: 42px;

    margin-bottom: 1.2rem;

    background: rgba(29, 185, 84, 0.08);

    color: var(--color-primary);

    border-radius: var(--radius-md);
  }

  .role-card h3 {
    font-size: var(--text-lg);
  }

  .role-card p {
    margin-top: 0.7rem;

    color: var(--color-text-muted);

    font-size: var(--text-sm);

    line-height: 1.7;
  }

  .tech-grid {
    display: grid;

    grid-template-columns: 0.8fr 1.2fr;

    gap: var(--space-16);

    align-items: start;
  }

  .tech-grid p {
    margin-top: 1rem;

    color: var(--color-text-muted);

    line-height: 1.7;
  }

  .tech-list {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 0.75rem;
  }

  .tech-item {
    display: flex;

    align-items: center;

    gap: 0.7rem;

    padding: 1rem;

    background: var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);
  }

  .tech-item svg {
    color: var(--color-primary);
  }

  .architecture {
    display: grid;

    grid-template-columns: repeat(5, 1fr);

    gap: 0.75rem;
  }

  .architecture-item {
    padding: 1.25rem;

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);
  }

  .architecture-item span {
    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: 0.7rem;
  }

  .architecture-item strong {
    display: block;

    margin-top: 1.5rem;

    font-size: var(--text-sm);

    line-height: 1.5;
  }

  .screenshots-section {
    background: var(--color-surface);
  }

  .screenshots-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 1rem;
  }

  .screenshots-grid figure {
    margin: 0;
  }

  .screenshots-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1.5rem;
  }

  .screenshots-grid figure {
    margin: 0;
  }

  .screenshot-button {
    position: relative;

    display: block;

    width: 100%;

    padding: 0;

    overflow: hidden;

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);

    cursor: zoom-in;

    text-align: left;
  }

  .screenshot-button img {
    display: block;

    width: 100%;
    height: 520px;

    object-fit: contain;

    background: linear-gradient(
      145deg,
      var(--color-surface),
      var(--color-background)
    );

    transition:
      transform 0.5s ease,
      filter 0.5s ease;
  }

  .screenshot-button:hover img {
    transform: scale(1.025);

    filter: brightness(0.88);
  }

  .zoom-indicator {
    position: absolute;

    right: 1rem;
    bottom: 1rem;

    display: grid;

    place-items: center;

    width: 42px;
    height: 42px;

    color: var(--color-black);

    background: var(--color-primary);

    border-radius: 50%;

    opacity: 0;

    transform: translateY(8px);

    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .screenshot-button:hover .zoom-indicator,
  .screenshot-button:focus-visible .zoom-indicator {
    opacity: 1;

    transform: translateY(0);
  }

  .screenshot-button:focus-visible {
    outline: 2px solid var(--color-primary);

    outline-offset: 4px;
  }

  .screenshots-grid figcaption {
    margin-top: 0.8rem;

    color: var(--color-text-muted);

    font-size: var(--text-sm);

    line-height: 1.5;
  }

  .screenshot-featured {
    grid-column: 1 / -1;
  }

  .screenshot-featured .screenshot-button img {
    height: 600px;
  }

  .screenshot-placeholder svg {
    color: var(--color-primary);
  }

  .screenshots-grid img {
    display: block;

    width: 100%;
    height: 320px;

    object-fit: cover;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);
  }

  figcaption {
    margin-top: 0.75rem;

    color: var(--color-text-muted);

    font-size: var(--text-sm);
  }

  .project-cta {
    padding-block: 0 var(--space-24);
  }

  .cta {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 2rem;

    padding: 3rem;

    background: linear-gradient(
      135deg,
      rgba(29, 185, 84, 0.12),
      var(--color-surface)
    );

    border: 1px solid rgba(29, 185, 84, 0.18);

    border-radius: var(--radius-xl);
  }

  .cta > div:first-child > span {
    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: 0.7rem;

    font-weight: 700;
  }

  .cta h2 {
    margin-top: 0.5rem;

    font-size: var(--text-2xl);
  }

  .cta p {
    margin-top: 0.7rem;

    color: var(--color-text-muted);
  }

  .cta-actions {
    display: flex;

    flex-shrink: 0;

    gap: 0.75rem;
  }

  .github-button,
  .back-button {
    display: inline-flex;

    align-items: center;

    gap: 0.5rem;

    min-height: 46px;

    padding: 0.7rem 1rem;

    border-radius: var(--radius-md);

    font-size: var(--text-sm);

    font-weight: 700;

    white-space: nowrap;
  }

  .github-button {
    background: var(--color-primary);

    color: var(--color-black);
  }

  .back-button {
    color: var(--color-text);

    border: 1px solid var(--color-border);
  }

  @media (max-width: 1000px) {
    .roles-grid {
      grid-template-columns: 1fr 1fr;
    }

    .architecture {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 800px) {
    .overview-grid,
    .problem-grid,
    .tech-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cta {
      align-items: flex-start;

      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .project-hero {
      padding-block: 4rem;
    }

    .project-hero h1 {
      font-size: 4rem;
    }

    .overview-section,
    .problem-section,
    .features-section,
    .roles-section,
    .tech-section,
    .architecture-section,
    .screenshots-section {
      padding-block: var(--space-16);
    }

    .features-grid,
    .roles-grid,
    .tech-list,
    .screenshots-grid {
      grid-template-columns: 1fr;
    }

    .architecture {
      grid-template-columns: 1fr;
    }

    .cta {
      padding: 1.5rem;
    }

    .cta-actions {
      width: 100%;

      flex-direction: column;
    }

    .image-modal {
      position: fixed;

      inset: 0;

      z-index: 1000;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 2rem;

      background: rgba(0, 0, 0, 0.88);

      opacity: 0;

      visibility: hidden;

      pointer-events: none;

      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
    }

    .image-modal[aria-hidden="false"] {
      opacity: 1;

      visibility: visible;

      pointer-events: auto;
    }

    .modal-content {
      position: relative;

      display: flex;

      flex-direction: column;

      align-items: center;

      max-width: 1100px;
      max-height: 95vh;
    }

    .modal-content img {
      display: block;

      max-width: 90vw;
      max-height: 82vh;

      width: auto;
      height: auto;

      object-fit: contain;

      border-radius: var(--radius-lg);

      box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
    }

    .modal-content p {
      margin-top: 1rem;

      color: white;

      text-align: center;

      font-size: var(--text-sm);
    }

    .modal-close {
      position: fixed;

      top: 1.5rem;
      right: 1.5rem;

      z-index: 1001;

      display: grid;

      place-items: center;

      width: 44px;
      height: 44px;

      padding: 0;

      color: white;

      background: rgba(255, 255, 255, 0.12);

      border: 1px solid rgba(255, 255, 255, 0.2);

      border-radius: 50%;

      font-size: 2rem;

      line-height: 1;

      cursor: pointer;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .modal-close:hover {
      background: rgba(255, 255, 255, 0.2);

      transform: rotate(90deg);
    }

    @media (max-width: 600px) {
      .image-modal {
        padding: 1rem;
      }

      .modal-content img {
        max-width: 94vw;

        max-height: 80vh;
      }

      .modal-close {
        top: 1rem;
        right: 1rem;
      }
    }

    .github-button,
    .back-button {
      justify-content: center;

      width: 100%;
    }
  }
</style>

<script>
  const modal = document.querySelector("#image-modal");

  const modalImage = document.querySelector("#modal-image");

  const modalCaption = document.querySelector("#modal-caption");

  const modalClose = document.querySelector("#modal-close");

  const screenshotButtons = document.querySelectorAll(".screenshot-button");

  function openModal(imageSrc: string, imageAlt: string, caption: string) {
    if (!modal || !modalImage) return;

    modalImage.setAttribute("src", imageSrc);
    modalImage.setAttribute("alt", imageAlt);
    modalCaption?.replaceChildren(caption);

    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal || !modalImage) return;

    modal.setAttribute("aria-hidden", "true");

    modalImage.setAttribute("src", "");
    modalCaption?.replaceChildren();

    document.body.style.overflow = "";
  }

  screenshotButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const imageSrc = button.getAttribute("data-image");

      const imageAlt = button.getAttribute("data-alt");
      const imageCaption = button.getAttribute("data-caption");

      if (!imageSrc || !imageAlt || !imageCaption) return;

      openModal(imageSrc, imageAlt, imageCaption);
    });
  });

  modalClose?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });
</script>
