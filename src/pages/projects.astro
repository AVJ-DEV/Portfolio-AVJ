---
import Layout from "../layouts/Layout.astro";
import { ArrowUpRight, Github, Code2 } from "lucide-astro";
import { projects } from "../data/projects";
---

<Layout
  title="Projets | Venceslas Jean de Dieu AGBEMATCHI"
  description="Découvrez les projets web et mobiles réalisés par Venceslas Jean de Dieu AGBEMATCHI."
>

  <main>

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="projects-hero">

      <div class="container">

        <div class="section-eyebrow">
          <span></span>
          MES PROJETS
        </div>

        <div class="hero-grid">

          <h1>
            Des idées transformées
            en solutions numériques.
          </h1>

          <div class="hero-intro">

            <p>
              Découvrez une sélection de mes projets dans
              le développement web, mobile et les systèmes
              informatiques.
            </p>

            <span class="project-count">
              {projects.length.toString().padStart(2, "0")}
              PROJET{projects.length > 1 ? "S" : ""}
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         PROJECTS
    ========================================== -->

    <section class="projects-section">

      <div class="container">

        <div class="projects-list">

          {
            projects.map((project, index) => {

              /*
               * La première capture du tableau screenshots
               * est utilisée comme image principale.
               *
               * Pour EcoTrack :
               * screenshots[0] = mobile-home.png
               */

              const cover = project.screenshots?.[0];

              return (

                <article
                  class:list={[
                    "project-card",
                    project.featured && "featured",
                  ]}
                >

                  <!-- ============================
                       IMAGE PRINCIPALE
                  ============================= -->

                  <div class="project-visual">

                    {
                      cover ? (
                        <img
                          src={cover.src}
                          alt={cover.alt}
                          loading={
                            index === 0
                              ? "eager"
                              : "lazy"
                          }
                        />
                      ) : (
                        <div class="image-placeholder">
                          <Code2 size={32} />
                          <span>
                            Aperçu du projet
                          </span>
                        </div>
                      )
                    }

                    <div class="project-overlay">

                      <span>
                        {project.year}
                      </span>

                      <span>
                        {project.category}
                      </span>

                    </div>

                  </div>


                  <!-- ============================
                       CONTENU
                  ============================= -->

                  <div class="project-content">

                    <div class="project-top">

                      <div>

                        <span class="project-number">
                          {String(index + 1).padStart(2, "0")}
                        </span>

                        <span class="project-category">
                          {project.category}
                        </span>

                      </div>


                      {
                        project.featured && (
                          <span class="featured-badge">
                            {project.status}
                          </span>
                        )
                      }

                    </div>


                    <h2>
                      {project.title}
                    </h2>


                    {
                      project.subtitle && (
                        <p class="project-subtitle">
                          {project.subtitle}
                        </p>
                      )
                    }


                    <p class="project-description">
                      {project.description}
                    </p>


                    <!-- ============================
                         TECHNOLOGIES
                    ============================= -->

                    <div class="technologies">

                      {
                        project.technologies.map(
                          (technology) => (

                            <span class="technology">

                              <Code2 size={13} />

                              {technology}

                            </span>

                          )
                        )
                      }

                    </div>


                    <!-- ============================
                         ACTIONS
                    ============================= -->

                    <div class="project-actions">

                      <a
                        href={`/projects/${project.slug}`}
                        class="primary-button"
                      >
                        Voir le projet

                        <ArrowUpRight size={17} />

                      </a>


                      {
                        project.links?.github && (
                          <a
                            href={project.links.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="secondary-button"
                          >
                            <Github size={17} />
                            GitHub
                          </a>
                        )
                      }

                    </div>

                  </div>

                </article>

              );

            })
          }

        </div>

      </div>

    </section>


    <!-- =========================================
         CTA
    ========================================== -->

    <section class="projects-cta">

      <div class="container">

        <div class="cta-card">

          <div>

            <div class="section-eyebrow">
              <span></span>
              COLLABORATION
            </div>

            <h2>
              Un projet à construire ?
            </h2>

            <p>
              Je suis ouvert aux projets, collaborations
              et opportunités permettant de créer des
              solutions numériques utiles et concrètes.
            </p>

          </div>


          <a
            href="/#contact"
            class="primary-button"
          >
            Me contacter

            <ArrowUpRight size={17} />

          </a>

        </div>

      </div>

    </section>

  </main>

</Layout>


<style>

  /* =========================================
     HERO
  ========================================== */

  .projects-hero {
    padding-block:
      clamp(6rem, 12vw, 10rem)
      var(--space-20);
  }


  .section-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: .55rem;

    margin-bottom: 1.5rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 700;

    letter-spacing: .08em;
  }


  .section-eyebrow span {
    width: 24px;
    height: 2px;

    background: var(--color-primary);

    border-radius: 999px;
  }


  .hero-grid {
    display: grid;

    grid-template-columns:
      1.2fr .8fr;

    gap: var(--space-16);

    align-items: end;
  }


  .hero-grid h1 {
    max-width: 900px;

    font-size: clamp(
      3.2rem,
      7vw,
      7rem
    );

    line-height: .92;

    letter-spacing: -.07em;
  }


  .hero-intro {
    max-width: 500px;
  }


  .hero-intro p {
    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;
  }


  .project-count {
    display: inline-block;

    margin-top: 1.5rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: .7rem;

    font-weight: 700;

    letter-spacing: .08em;
  }


  /* =========================================
     PROJECTS
  ========================================== */

  .projects-section {
    padding-block: var(--space-16);

    border-top: 1px solid var(--color-border);
  }


  .projects-list {
    display: flex;

    flex-direction: column;

    gap: var(--space-12);
  }


  .project-card {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    overflow: hidden;

    background: var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);

    transition:
      border-color .3s ease,
      transform .3s ease;
  }


  .project-card:hover {
    transform: translateY(-4px);

    border-color:
      rgba(29, 185, 84, .35);
  }


  /* =========================================
     VISUAL
  ========================================== */

  .project-visual {
    position: relative;

    min-height: 500px;

    overflow: hidden;

    background:
      linear-gradient(
        135deg,
        rgba(29, 185, 84, .08),
        var(--color-background)
      );
  }


  .project-visual img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform .5s ease;
  }


  .project-card:hover
  .project-visual img {
    transform: scale(1.03);
  }


  /* Placeholder si aucune capture
     n'est disponible */

  .image-placeholder {
    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    gap: .75rem;

    width: 100%;
    height: 100%;

    min-height: 500px;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: .7rem;
  }


  .image-placeholder svg {
    color: var(--color-primary);
  }


  .project-overlay {
    position: absolute;

    left: 1rem;
    right: 1rem;
    bottom: 1rem;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    padding: .7rem 1rem;

    color: white;

    background:
      rgba(0, 0, 0, .65);

    backdrop-filter: blur(10px);

    border: 1px solid
      rgba(255, 255, 255, .12);

    border-radius: var(--radius-md);

    font-family: var(--font-mono);

    font-size: .65rem;
  }


  /* =========================================
     CONTENT
  ========================================== */

  .project-content {
    display: flex;

    flex-direction: column;

    justify-content: center;

    padding: clamp(
      2rem,
      5vw,
      4rem
    );
  }


  .project-top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;
  }


  .project-number {
    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: .7rem;

    font-weight: 700;
  }


  .project-category {
    margin-left: .75rem;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: .65rem;

    text-transform: uppercase;
  }


  .featured-badge {
    padding: .4rem .6rem;

    color: var(--color-primary);

    background:
      rgba(29, 185, 84, .08);

    border: 1px solid
      rgba(29, 185, 84, .2);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: .6rem;

    font-weight: 700;

    text-transform: uppercase;
  }


  .project-content h2 {
    margin-top: 1.5rem;

    font-size: clamp(
      3rem,
      5vw,
      5rem
    );

    line-height: .95;

    letter-spacing: -.06em;
  }


  .project-subtitle {
    margin-top: .6rem;

    color: var(--color-text-secondary);

    font-size: var(--text-lg);

    font-weight: 500;

    line-height: 1.5;
  }


  .project-description {
    max-width: 650px;

    margin-top: 1.25rem;

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;
  }


  /* =========================================
     TECHNOLOGIES
  ========================================== */

  .technologies {
    display: flex;

    flex-wrap: wrap;

    gap: .45rem;

    margin-top: 1.75rem;
  }


  .technology {
    display: inline-flex;

    align-items: center;

    gap: .35rem;

    padding: .45rem .65rem;

    color: var(--color-text-secondary);

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: .62rem;
  }


  .technology svg {
    color: var(--color-primary);
  }


  /* =========================================
     ACTIONS
  ========================================== */

  .project-actions {
    display: flex;

    flex-wrap: wrap;

    gap: .65rem;

    margin-top: 2rem;
  }


  .primary-button,
  .secondary-button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: .5rem;

    padding: .8rem 1rem;

    border-radius: var(--radius-md);

    font-size: var(--text-sm);

    font-weight: 700;

    transition:
      transform .2s ease,
      opacity .2s ease;
  }


  .primary-button {
    color: var(--color-black);

    background: var(--color-primary);
  }


  .secondary-button {
    color: var(--color-text);

    background: transparent;

    border: 1px solid var(--color-border);
  }


  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);

    opacity: .9;
  }


  /* =========================================
     CTA
  ========================================== */

  .projects-cta {
    padding-block: var(--space-24);

    border-top: 1px solid var(--color-border);
  }


  .cta-card {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 3rem;

    padding: clamp(
      2rem,
      5vw,
      4rem
    );

    background:
      linear-gradient(
        135deg,
        rgba(29, 185, 84, .1),
        var(--color-surface)
      );

    border: 1px solid
      rgba(29, 185, 84, .18);

    border-radius: var(--radius-xl);
  }


  .cta-card h2 {
    font-size: clamp(
      2.5rem,
      5vw,
      4rem
    );

    line-height: 1;

    letter-spacing: -.05em;
  }


  .cta-card p {
    max-width: 650px;

    margin-top: .8rem;

    color: var(--color-text-muted);

    line-height: 1.7;
  }


  /* =========================================
     RESPONSIVE
  ========================================== */

  @media (max-width: 900px) {

    .hero-grid {
      grid-template-columns: 1fr;

      gap: 2rem;
    }


    .project-card {
      grid-template-columns: 1fr;
    }


    .project-visual {
      min-height: 400px;
    }


    .image-placeholder {
      min-height: 400px;
    }


    .cta-card {
      align-items: flex-start;

      flex-direction: column;
    }

  }


  @media (max-width: 600px) {

    .projects-hero,
    .projects-cta {
      padding-block: var(--space-16);
    }


    .hero-grid h1 {
      font-size: 3.2rem;
    }


    .project-visual {
      min-height: 300px;
    }


    .image-placeholder {
      min-height: 300px;
    }


    .project-content {
      padding: 1.5rem;
    }


    .project-content h2 {
      font-size: 3rem;
    }


    .project-overlay {
      align-items: flex-start;

      flex-direction: column;

      gap: .3rem;
    }

  }

</style>