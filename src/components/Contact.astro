---
import {
  Mail,
  Phone,
  MessageCircle,
  ArrowUpRight,
  Copy,
  Check,
} from "lucide-astro";
---

<section
  class="contact-section"
  id="contact"
>
  <div class="container">

    <div class="contact-card">

      <div class="contact-main">

        <div class="section-eyebrow">
          <span></span>
          CONTACT
        </div>

        <h2>
          Un projet,
          une idée ou
          une opportunité ?
        </h2>

        <p>
          Vous souhaitez échanger autour d'un projet,
          d'une collaboration ou d'une opportunité
          professionnelle ? Je serais heureux d'en discuter
          avec vous.
        </p>

      </div>


      <div class="contact-actions">

        <!-- EMAIL -->
        <a
          href="mailto:agbematchiavj@gmail.com"
          class="contact-item"
        >

          <div class="contact-icon">
            <Mail size={21} />
          </div>

          <div class="contact-info">
            <span>Email</span>

            <strong>
              agbematchiavj@gmail.com
            </strong>
          </div>

          <ArrowUpRight size={18} />

        </a>


        <!-- WHATSAPP -->
        <a
          href="https://wa.me/2290157801588"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-item"
        >

          <div class="contact-icon">
            <MessageCircle size={21} />
          </div>

          <div class="contact-info">
            <span>WhatsApp</span>

            <strong>
              +229 01 57 80 15 88
            </strong>
          </div>

          <ArrowUpRight size={18} />

        </a>


        <!-- TELEPHONE 1 -->
        <a
          href="tel:+2290141451727"
          class="contact-item"
        >

          <div class="contact-icon">
            <Phone size={21} />
          </div>

          <div class="contact-info">
            <span>Téléphone</span>

            <strong>
              +229 01 41 45 17 27
            </strong>
          </div>

          <ArrowUpRight size={18} />

        </a>


        <!-- TELEPHONE 2 -->
        <a
          href="tel:+2290193300043"
          class="contact-item"
        >

          <div class="contact-icon">
            <Phone size={21} />
          </div>

          <div class="contact-info">
            <span>Second numéro</span>

            <strong>
              +229 01 93 30 00 43
            </strong>
          </div>

          <ArrowUpRight size={18} />

        </a>

      </div>

    </div>


    <!-- COPIER L'EMAIL -->

    <div class="contact-bottom">

      <span>
        Disponible pour de nouvelles collaborations.
      </span>

      <button
        type="button"
        class="copy-email"
        data-email="agbematchiavj@gmail.com"
      >
        <Copy size={15} />
        Copier mon email
      </button>

    </div>

  </div>
</section>


<script>
  const copyButton =
    document.querySelector(".copy-email");

  copyButton?.addEventListener("click", async () => {

    const email =
      copyButton.getAttribute("data-email");

    if (!email) return;

    try {

      await navigator.clipboard.writeText(email);

      copyButton.innerHTML = `
        <span>✓</span>
        Email copié
      `;

      setTimeout(() => {

        copyButton.innerHTML = `
          <span>⧉</span>
          Copier mon email
        `;

      }, 2000);

    } catch {

      window.location.href =
        `mailto:${email}`;

    }

  });
</script>


<style>

  .contact-section {
    padding-block: var(--space-24);

    border-top: 1px solid var(--color-border);
  }


  /* ================================
     CARD
  ================================= */

  .contact-card {
    display: grid;

    grid-template-columns:
      1.1fr .9fr;

    gap: var(--space-16);

    padding: clamp(
      2rem,
      5vw,
      5rem
    );

    background:
      linear-gradient(
        135deg,
        rgba(29, 185, 84, .12),
        var(--color-surface) 60%
      );

    border: 1px solid
      rgba(29, 185, 84, .18);

    border-radius: var(--radius-xl);
  }


  /* ================================
     HEADER
  ================================= */

  .section-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: .55rem;

    margin-bottom: 1.25rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 700;

    letter-spacing: .08em;
  }

  .section-eyebrow span {
    width: 24px;
    height: 2px;

    background: var(--color-primary);

    border-radius: 999px;
  }

  .contact-main h2 {
    max-width: 700px;

    font-size: clamp(
      2.8rem,
      6vw,
      5.5rem
    );

    line-height: .95;

    letter-spacing: -.06em;
  }

  .contact-main p {
    max-width: 600px;

    margin-top: 1.5rem;

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;
  }


  /* ================================
     CONTACT ITEMS
  ================================= */

  .contact-actions {
    display: flex;

    flex-direction: column;

    gap: .65rem;

    justify-content: center;
  }

  .contact-item {
    display: flex;

    align-items: center;

    gap: 1rem;

    padding: 1rem;

    color: var(--color-text);

    background:
      rgba(255, 255, 255, .025);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    transition:
      transform .25s ease,
      border-color .25s ease,
      background .25s ease;
  }

  .contact-item:hover {
    transform: translateX(5px);

    border-color:
      rgba(29, 185, 84, .4);

    background:
      rgba(29, 185, 84, .05);
  }

  .contact-icon {
    display: grid;

    place-items: center;

    flex-shrink: 0;

    width: 46px;
    height: 46px;

    color: var(--color-primary);

    background:
      rgba(29, 185, 84, .09);

    border-radius: var(--radius-md);
  }

  .contact-info {
    display: flex;

    flex-direction: column;

    flex: 1;

    min-width: 0;

    gap: .2rem;
  }

  .contact-info span {
    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: .62rem;

    font-weight: 700;

    letter-spacing: .05em;

    text-transform: uppercase;
  }

  .contact-info strong {
    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: var(--text-sm);
  }


  /* ================================
     BOTTOM
  ================================= */

  .contact-bottom {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    margin-top: 1rem;

    padding: 1rem 1.25rem;

    color: var(--color-text-muted);

    border-bottom: 1px solid var(--color-border);

    font-size: var(--text-sm);
  }

  .copy-email {
    display: inline-flex;

    align-items: center;

    gap: .45rem;

    padding: .55rem .75rem;

    color: var(--color-text-secondary);

    background: transparent;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    font-family: inherit;

    font-size: .75rem;

    cursor: pointer;

    transition:
      color .2s ease,
      border-color .2s ease;
  }

  .copy-email:hover {
    color: var(--color-primary);

    border-color: var(--color-primary);
  }


  /* ================================
     RESPONSIVE
  ================================= */

  @media (max-width: 900px) {

    .contact-card {
      grid-template-columns: 1fr;

      gap: 3rem;
    }

  }


  @media (max-width: 600px) {

    .contact-section {
      padding-block: var(--space-16);
    }

    .contact-card {
      padding: 1.5rem;
    }

    .contact-main h2 {
      font-size: 3rem;
    }

    .contact-bottom {
      align-items: flex-start;

      flex-direction: column;
    }

    .copy-email {
      width: 100%;

      justify-content: center;
    }

  }

</style>