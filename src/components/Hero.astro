---
import {
  ArrowDown,
  ArrowRight,
  Github,
  Mail,
  MapPin,
} from "lucide-astro";
---

<section class="hero" id="home">
  <div class="hero-background">
    <div class="hero-grid"></div>
    <div class="hero-glow hero-glow-one"></div>
    <div class="hero-glow hero-glow-two"></div>
  </div>

  <div class="container hero-container">

    <div class="hero-content">

      <div class="hero-badge">
        <span class="status-dot"></span>

        <span>
          Disponible pour de nouveaux projets
        </span>
      </div>

      <p class="hero-intro">
        Bonjour, je suis
      </p>

      <h1 class="hero-title">
        Venceslas Jean de Dieu
        <span>AGBEMATCHI</span>
      </h1>

      <div class="hero-role">
        <span class="role-primary">
          Développeur Web & Mobile
        </span>

        <span class="role-separator">·</span>

        <span>
          Enseignant en Informatique
        </span>
      </div>

      <p class="hero-description">
        Je conçois des solutions numériques modernes
        et je transmets mes compétences à travers
        l'enseignement et la formation.
      </p>

      <div class="hero-actions">

        <a
          href="/projects"
          class="button button-primary"
        >
          Voir mes projets
          <ArrowRight size={18} />
        </a>

        <a
          href="/contact"
          class="button button-secondary"
        >
          Me contacter
          <Mail size={18} />
        </a>

      </div>

      <div class="hero-meta">

        <a
          href="https://github.com/AVJ-DEV"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-social"
        >
          <Github size={18} />
          <span>AVJ-DEV</span>
        </a>

        <a
          href="mailto:agbematchiavj@gmail.com"
          class="hero-social"
        >
          <Mail size={18} />
          <span>Email</span>
        </a>

        <div class="hero-location">
          <MapPin size={18} />
          <span>Bénin</span>
        </div>

      </div>

    </div>

    <div class="hero-visual">

      <div class="hero-image-wrapper">

        <div class="hero-image-decoration decoration-one"></div>
        <div class="hero-image-decoration decoration-two"></div>

        <div class="hero-image-border"></div>

        <div class="hero-image">
          <img
            src="/images/profile/avatar.jpg"
            alt="Venceslas Jean de Dieu AGBEMATCHI"
            width="600"
            height="750"
            loading="eager"
          />
        </div>

        <div class="code-card code-card-top">
          <span>&lt;/&gt;</span>
        </div>

        <div class="code-card code-card-bottom">
          <span>Flutter</span>
        </div>

      </div>

    </div>

  </div>

  <a
    href="#about-preview"
    class="scroll-indicator"
    aria-label="Découvrir la suite"
  >
    <span>Découvrir</span>
    <ArrowDown size={18} />
  </a>
</section>

<style>
  .hero {
    position: relative;

    min-height: calc(100vh - var(--header-height));

    display: flex;
    align-items: center;

    overflow: hidden;

    padding-block: var(--space-20);
  }

  .hero-background {
    position: absolute;
    inset: 0;

    pointer-events: none;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: 0;

    opacity: 0.35;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      );

    background-size: 50px 50px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 90%
      );
  }

  :global(:root[data-theme="light"]) .hero-grid {
    background-image:
      linear-gradient(
        rgba(15, 23, 42, 0.04) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(15, 23, 42, 0.04) 1px,
        transparent 1px
      );
  }

  .hero-glow {
    position: absolute;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    background: var(--color-primary);

    filter: blur(140px);

    opacity: 0.08;
  }

  .hero-glow-one {
    top: 5%;
    left: -15%;
  }

  .hero-glow-two {
    right: -15%;
    bottom: 0;
  }

  .hero-container {
    position: relative;

    display: grid;

    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(350px, 0.85fr);

    align-items: center;

    gap: var(--space-16);
  }

  .hero-content {
    position: relative;

    z-index: 2;

    max-width: 700px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;

    gap: 0.55rem;

    margin-bottom: var(--space-6);

    padding: 0.45rem 0.75rem;

    background: rgba(29, 185, 84, 0.08);

    border: 1px solid rgba(29, 185, 84, 0.18);

    border-radius: var(--radius-full);

    color: var(--color-primary);

    font-size: var(--text-xs);
    font-weight: 600;

    animation: hero-fade-up 0.6s ease both;
  }

  .status-dot {
    width: 7px;
    height: 7px;

    background: var(--color-primary);

    border-radius: 50%;

    box-shadow:
      0 0 0 4px rgba(29, 185, 84, 0.1);

    animation: pulse-dot 2s infinite;
  }

  .hero-intro {
    margin-bottom: var(--space-2);

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-sm);
    font-weight: 600;

    letter-spacing: 0.04em;

    animation:
      hero-fade-up 0.6s 0.1s ease both;
  }

  .hero-title {
    max-width: 850px;

    font-size: clamp(
      2.6rem,
      6vw,
      5.4rem
    );

    letter-spacing: -0.055em;

    line-height: 0.98;

    animation:
      hero-fade-up 0.7s 0.15s ease both;
  }

  .hero-title span {
    display: block;

    color: var(--color-primary);
  }

  .hero-role {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 0.65rem;

    margin-top: var(--space-6);

    color: var(--color-text-secondary);

    font-size: clamp(
      1rem,
      2vw,
      1.25rem
    );

    font-weight: 500;

    animation:
      hero-fade-up 0.7s 0.25s ease both;
  }

  .role-primary {
    color: var(--color-text);
    font-weight: 700;
  }

  .role-separator {
    color: var(--color-primary);
  }

  .hero-description {
    max-width: 620px;

    margin-top: var(--space-6);

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;

    animation:
      hero-fade-up 0.7s 0.35s ease both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 0.85rem;

    margin-top: var(--space-8);

    animation:
      hero-fade-up 0.7s 0.45s ease both;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.55rem;

    min-height: 48px;

    padding: 0.75rem 1.15rem;

    border-radius: var(--radius-md);

    font-size: var(--text-sm);
    font-weight: 700;

    transition:
      transform var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .button-primary {
    background: var(--color-primary);
    color: var(--color-black);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);

    transform: translateY(-2px);

    box-shadow:
      0 10px 25px rgba(29, 185, 84, 0.18);
  }

  .button-secondary {
    background: var(--color-surface);

    color: var(--color-text);

    border: 1px solid var(--color-border);
  }

  .button-secondary:hover {
    color: var(--color-primary);

    border-color: var(--color-primary);

    transform: translateY(-2px);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 1.25rem;

    margin-top: var(--space-8);

    animation:
      hero-fade-up 0.7s 0.55s ease both;
  }

  .hero-social,
  .hero-location {
    display: inline-flex;
    align-items: center;

    gap: 0.45rem;

    color: var(--color-text-muted);

    font-size: var(--text-sm);

    transition: color var(--transition-fast);
  }

  .hero-social:hover {
    color: var(--color-primary);
  }

  .hero-location svg,
  .hero-social svg {
    color: var(--color-primary);
  }

  .hero-visual {
    position: relative;

    z-index: 2;

    display: flex;
    justify-content: center;

    animation:
      hero-image-in 0.9s 0.2s ease both;
  }

  .hero-image-wrapper {
    position: relative;

    width: min(100%, 470px);

    aspect-ratio: 4 / 5;
  }

  .hero-image {
    position: absolute;

    inset: 14px;

    overflow: hidden;

    background: var(--color-surface);

    border-radius:
      var(--radius-xl)
      var(--radius-xl)
      5rem
      var(--radius-xl);

    border: 1px solid var(--color-border);

    box-shadow: var(--shadow-lg);

    z-index: 2;
  }

  .hero-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transition: transform 700ms ease;
  }

  .hero-image-wrapper:hover .hero-image img {
    transform: scale(1.03);
  }

  .hero-image-border {
    position: absolute;

    inset: 0;

    border: 2px solid var(--color-primary);

    border-radius:
      var(--radius-xl)
      var(--radius-xl)
      5rem
      var(--radius-xl);

    transform: rotate(4deg);

    opacity: 0.5;

    z-index: 1;
  }

  .hero-image-decoration {
    position: absolute;

    width: 70px;
    height: 70px;

    border: 1px solid var(--color-primary);

    opacity: 0.35;

    z-index: 0;
  }

  .decoration-one {
    top: -25px;
    right: -25px;

    border-radius: 50%;
  }

  .decoration-two {
    left: -30px;
    bottom: 20px;

    width: 45px;
    height: 45px;

    border-radius: var(--radius-md);

    transform: rotate(45deg);
  }

  .code-card {
    position: absolute;

    z-index: 3;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    box-shadow: var(--shadow-md);

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-sm);
    font-weight: 700;
  }

  .code-card-top {
    top: 10%;

    left: -35px;

    width: 64px;
    height: 64px;

    transform: rotate(-8deg);
  }

  .code-card-bottom {
    right: -30px;
    bottom: 13%;

    padding: 0.75rem 1rem;

    transform: rotate(6deg);
  }

  .scroll-indicator {
    position: absolute;

    left: 50%;
    bottom: 1.5rem;

    display: flex;
    align-items: center;

    gap: 0.4rem;

    color: var(--color-text-muted);

    font-size: var(--text-xs);

    transform: translateX(-50%);

    animation:
      scroll-bounce 2s infinite;

    transition: color var(--transition-fast);
  }

  .scroll-indicator:hover {
    color: var(--color-primary);
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-image-in {
    from {
      opacity: 0;
      transform: translateX(30px) scale(0.97);
    }

    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes pulse-dot {
    0%,
    100% {
      box-shadow:
        0 0 0 4px rgba(29, 185, 84, 0.1);
    }

    50% {
      box-shadow:
        0 0 0 8px rgba(29, 185, 84, 0.04);
    }
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform:
        translateX(-50%)
        translateY(0);
    }

    50% {
      transform:
        translateX(-50%)
        translateY(6px);
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--space-16);
    }

    .hero-container {
      grid-template-columns: 1fr;

      gap: var(--space-12);
    }

    .hero-content {
      max-width: 800px;

      text-align: center;

      margin-inline: auto;
    }

    .hero-badge,
    .hero-role,
    .hero-actions,
    .hero-meta {
      justify-content: center;
    }

    .hero-description {
      margin-inline: auto;
    }

    .hero-visual {
      max-width: 430px;

      width: 100%;

      margin-inline: auto;
    }

    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;

      padding-top: var(--space-12);
      padding-bottom: var(--space-16);
    }

    .hero-container {
      gap: var(--space-10);
    }

    .hero-badge {
      font-size: 0.7rem;
    }

    .hero-title {
      font-size: clamp(
        2.45rem,
        12vw,
        4rem
      );
    }

    .hero-role {
      font-size: 1rem;
    }

    .hero-description {
      font-size: var(--text-base);

      line-height: 1.7;
    }

    .hero-actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .hero-meta {
      gap: 0.9rem;
    }

    .hero-image-wrapper {
      width: min(
        100%,
        360px
      );
    }

    .code-card-top {
      left: -8px;
    }

    .code-card-bottom {
      right: -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge,
    .hero-intro,
    .hero-title,
    .hero-role,
    .hero-description,
    .hero-actions,
    .hero-meta,
    .hero-visual {
      animation: none;
    }

    .status-dot,
    .scroll-indicator {
      animation: none;
    }
  }
</style>