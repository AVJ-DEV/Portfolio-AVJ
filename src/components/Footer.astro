---
import {
  Github,
  Mail,
  ArrowUp,
} from "lucide-astro";
---

<footer class="site-footer">

  <div class="container">

    <div class="footer-top">

      <div class="footer-brand">

        <a href="/" class="logo">
          <span class="logo-mark">AVJ</span>

          <span class="logo-text">
            Venceslas
          </span>
        </a>

        <p>
          Développeur Web & Mobile
          <br />
          Enseignant en Informatique
        </p>

      </div>

      <div class="footer-navigation">

        <h3>Navigation</h3>

        <a href="/about">À propos</a>
        <a href="/about#competences">Compétences</a>
        <a href="/projects">Projets</a>
        <a href="/about#experience">Expériences</a>
        <a href="/#contact">Contact</a>

      </div>

      <div class="footer-contact">

        <h3>Me contacter</h3>

        <a href="mailto:agbematchiavj@gmail.com">
          <Mail size={17} />
          <span>
            agbematchiavj@gmail.com
          </span>
        </a>

        <a
          href="https://github.com/AVJ-DEV"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Github size={17} />
          <span>
            GitHub
          </span>
        </a>

      </div>

    </div>

    <div class="footer-bottom">

      <p>
        © {new Date().getFullYear()}
        Venceslas Jean de Dieu AGBEMATCHI.
        Tous droits réservés.
      </p>

      <a
        href="#top"
        class="back-to-top"
        aria-label="Retour en haut"
      >
        <ArrowUp size={18} />
      </a>

    </div>

  </div>

</footer>