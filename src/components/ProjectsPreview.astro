---
import { ArrowRight, ArrowUpRight, Github } from "lucide-astro";

import { projects } from "../data/projects";
import { withBase } from "../utils/site";

const featuredProjects = projects.filter((project) => project.featured);
---

<section class="projects-preview" id="projets">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">
        <span></span>
        PROJETS SÉLECTIONNÉS
      </div>

      <div class="header-content">
        <h2>Je transforme les idées en solutions numériques.</h2>

        <p>
          Quelques projets qui illustrent mon approche, mes compétences
          techniques et ma capacité à construire des solutions concrètes.
        </p>
      </div>
    </div>

    {
      featuredProjects.map((project) => (
        <article class="featured-project">
          <div class="project-visual">
            <div class="browser-frame">
              <div class="browser-header">
                <div class="browser-dots">
                  <span />
                  <span />
                  <span />
                </div>

                <div class="browser-title">EcoTrack</div>
              </div>

              <div class="ecotrack-preview">
                <img
                  src={withBase(project.screenshots[0].src)}
                  alt={project.screenshots[0].alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>

          <div class="project-content">
            <div class="project-meta">
              <span class="project-number">01</span>

              <span>{project.category}</span>
            </div>

            <span class="project-status">{project.status}</span>

            <h3>{project.title}</h3>

            <p class="project-subtitle">{project.subtitle}</p>

            <p class="project-description">{project.description}</p>

            <div class="project-technologies">
              {project.technologies.slice(0, 7).map((technology) => (
                <span>{technology}</span>
              ))}
            </div>

            <div class="project-actions">
              <a
                href={withBase(`/projects/${project.slug}`)}
                class="primary-button"
              >
                Découvrir le projet
                <ArrowRight size={17} />
              </a>

              {project.links.github && (
                <a
                  href={project.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="github-link"
                >
                  <Github size={17} />
                  GitHub
                  <ArrowUpRight size={15} />
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }

    <div class="all-projects">
      <a href={withBase("/projects")}>
        Voir tous les projets

        <ArrowRight size={17} />
      </a>
    </div>
  </div>
</section>

<style>
  .projects-preview {
    padding-block: var(--space-24);

    border-top: 1px solid var(--color-border);
  }

  /* HEADER */

  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: 0.55rem;

    margin-bottom: 1rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 700;

    letter-spacing: 0.08em;
  }

  .section-eyebrow span {
    width: 24px;
    height: 2px;

    background: var(--color-primary);

    border-radius: 999px;
  }

  .header-content {
    display: grid;

    grid-template-columns: 1.1fr 0.9fr;

    gap: var(--space-16);

    align-items: end;
  }

  .header-content h2 {
    max-width: 800px;

    font-size: clamp(2.5rem, 5vw, 4.5rem);

    line-height: 1;

    letter-spacing: -0.055em;
  }

  .header-content p {
    max-width: 520px;

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;
  }

  /* PROJECT */

  .featured-project {
    display: grid;

    grid-template-columns: 1.15fr 0.85fr;

    gap: var(--space-16);

    align-items: center;

    padding: 1rem;

    background: linear-gradient(145deg, var(--color-surface), transparent);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);
  }

  /* VISUAL */

  .project-visual {
    min-width: 0;
  }

  .browser-frame {
    overflow: hidden;

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.12);
  }

  .browser-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0.8rem 1rem;

    border-bottom: 1px solid var(--color-border);
  }

  .browser-dots {
    display: flex;

    gap: 5px;
  }

  .browser-dots span {
    width: 8px;
    height: 8px;

    background: var(--color-border);

    border-radius: 50%;
  }

  .browser-title {
    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: 0.65rem;
  }

  .ecotrack-preview {
    display: grid;

    place-items: center;

    min-height: 430px;

    padding: 1rem;

    background: var(--color-surface);

    text-align: center;
  }

  .ecotrack-preview img {
    display: block;

    width: 100%;
    height: clamp(320px, 40vw, 520px);

    object-fit: contain;
  }

  /* CONTENT */

  .project-content {
    padding: 2rem;

    max-width: 600px;
  }

  .project-meta {
    display: flex;

    align-items: center;

    gap: 0.75rem;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: 0.68rem;

    text-transform: uppercase;
  }

  .project-number {
    color: var(--color-primary);

    font-weight: 700;
  }

  .project-status {
    display: inline-block;

    margin-top: 1.5rem;

    padding: 0.35rem 0.65rem;

    color: var(--color-primary);

    background: rgba(29, 185, 84, 0.08);

    border: 1px solid rgba(29, 185, 84, 0.15);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: 0.65rem;

    font-weight: 700;
  }

  .project-content h3 {
    margin-top: 0.8rem;

    font-size: clamp(2.5rem, 5vw, 4rem);

    letter-spacing: -0.06em;

    line-height: 1;
  }

  .project-subtitle {
    margin-top: 0.75rem;

    color: var(--color-text-secondary);

    font-size: var(--text-lg);

    line-height: 1.5;
  }

  .project-description {
    margin-top: 1.25rem;

    color: var(--color-text-muted);

    line-height: 1.8;
  }

  /* TECHNOLOGIES */

  .project-technologies {
    display: flex;

    flex-wrap: wrap;

    gap: 0.45rem;

    margin-top: 1.5rem;
  }

  .project-technologies span {
    padding: 0.35rem 0.6rem;

    color: var(--color-text-secondary);

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: 0.65rem;
  }

  /* ACTIONS */

  .project-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 0.75rem;

    margin-top: 2rem;
  }

  .primary-button,
  .github-link {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 0.5rem;

    min-height: 45px;

    padding: 0.7rem 1rem;

    border-radius: var(--radius-md);

    font-size: var(--text-sm);

    font-weight: 700;
  }

  .primary-button {
    color: var(--color-black);

    background: var(--color-primary);
  }

  .github-link {
    color: var(--color-text);

    border: 1px solid var(--color-border);
  }

  .github-link:hover {
    color: var(--color-primary);

    border-color: var(--color-primary);
  }

  /* ALL PROJECTS */

  .all-projects {
    display: flex;

    justify-content: center;

    margin-top: 2.5rem;
  }

  .all-projects a {
    display: inline-flex;

    align-items: center;

    gap: 0.5rem;

    color: var(--color-text-secondary);

    font-size: var(--text-sm);

    font-weight: 700;

    border-bottom: 1px solid var(--color-border);

    padding-bottom: 0.3rem;

    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .all-projects a:hover {
    color: var(--color-primary);

    border-color: var(--color-primary);
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .header-content {
      grid-template-columns: 1fr;

      gap: 1.5rem;
    }

    .featured-project {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .projects-preview {
      padding-block: var(--space-16);
    }

    .project-content {
      padding: 1.25rem;
    }

    .ecotrack-preview {
      min-height: 350px;
      padding: 0.75rem;
    }

    .project-actions {
      flex-direction: column;
    }

    .primary-button,
    .github-link {
      width: 100%;
    }
  }
</style>
