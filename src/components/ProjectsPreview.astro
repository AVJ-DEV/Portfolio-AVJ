---
import {
  ArrowRight,
  ArrowUpRight,
  Github,
  Layers3,
} from "lucide-astro";

import { projects } from "../data/projects";

const featuredProjects = projects.filter(
  (project) => project.featured
);
---

<section
  class="projects-preview"
  id="projets"
>
  <div class="container">

    <div class="section-header">

      <div class="section-eyebrow">
        <span></span>
        PROJETS SÉLECTIONNÉS
      </div>

      <div class="header-content">

        <h2>
          Je transforme les idées
          en solutions numériques.
        </h2>

        <p>
          Quelques projets qui illustrent mon approche,
          mes compétences techniques et ma capacité à
          construire des solutions concrètes.
        </p>

      </div>

    </div>


    {
      featuredProjects.map((project) => (

        <article class="featured-project">

          <div class="project-visual">

            <div class="browser-frame">

              <div class="browser-header">

                <div class="browser-dots">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="browser-title">
                  EcoTrack
                </div>

              </div>


              <div class="ecotrack-preview">

                <div class="preview-logo">
                  <Layers3 size={30} />
                </div>

                <strong>
                  EcoTrack
                </strong>

                <span>
                  Signalez, protégez, agissez.
                </span>

                <div class="preview-cards">

                  <div></div>
                  <div></div>
                  <div></div>

                </div>

              </div>

            </div>

          </div>


          <div class="project-content">

            <div class="project-meta">

              <span class="project-number">
                01
              </span>

              <span>
                {project.category}
              </span>

            </div>


            <span class="project-status">
              {project.status}
            </span>


            <h3>
              {project.title}
            </h3>

            <p class="project-subtitle">
              {project.subtitle}
            </p>

            <p class="project-description">
              {project.description}
            </p>


            <div class="project-technologies">

              {
                project.technologies
                  .slice(0, 7)
                  .map((technology) => (
                    <span>{technology}</span>
                  ))
              }

            </div>


            <div class="project-actions">

              <a
                href={`/projects/${project.slug}`}
                class="primary-button"
              >
                Découvrir le projet
                <ArrowRight size={17} />
              </a>


              {
                project.links.github && (

                  <a
                    href={project.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="github-link"
                  >
                    <Github size={17} />
                    GitHub
                    <ArrowUpRight size={15} />
                  </a>

                )
              }

            </div>

          </div>

        </article>

      ))
    }


    <div class="all-projects">

      <a href="/projects">

        Voir tous les projets

        <ArrowRight size={17} />

      </a>

    </div>

  </div>
</section>


<style>

  .projects-preview {
    padding-block: var(--space-24);

    border-top: 1px solid var(--color-border);
  }


  /* HEADER */

  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: .55rem;

    margin-bottom: 1rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 700;

    letter-spacing: .08em;
  }

  .section-eyebrow span {
    width: 24px;
    height: 2px;

    background: var(--color-primary);

    border-radius: 999px;
  }

  .header-content {
    display: grid;

    grid-template-columns:
      1.1fr .9fr;

    gap: var(--space-16);

    align-items: end;
  }

  .header-content h2 {
    max-width: 800px;

    font-size: clamp(
      2.5rem,
      5vw,
      4.5rem
    );

    line-height: 1;

    letter-spacing: -.055em;
  }

  .header-content p {
    max-width: 520px;

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;
  }


  /* PROJECT */

  .featured-project {
    display: grid;

    grid-template-columns:
      1.15fr .85fr;

    gap: var(--space-16);

    align-items: center;

    padding: 1rem;
    
    background:
      linear-gradient(
        145deg,
        var(--color-surface),
        transparent
      );

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);
  }


  /* VISUAL */

  .project-visual {
    min-width: 0;
  }

  .browser-frame {
    overflow: hidden;

    background:
      var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    box-shadow:
      0 25px 70px rgba(0, 0, 0, .12);
  }

  .browser-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: .8rem 1rem;

    border-bottom: 1px solid var(--color-border);
  }

  .browser-dots {
    display: flex;

    gap: 5px;
  }

  .browser-dots span {
    width: 8px;
    height: 8px;

    background: var(--color-border);

    border-radius: 50%;
  }

  .browser-title {
    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: .65rem;
  }


  .ecotrack-preview {
    display: flex;

    align-items: center;

    flex-direction: column;

    min-height: 430px;

    padding: 3rem 2rem;

    background:
      radial-gradient(
        circle at 50% 20%,
        rgba(29, 185, 84, .16),
        transparent 55%
      );

    text-align: center;
  }

  .preview-logo {
    display: grid;

    place-items: center;

    width: 70px;
    height: 70px;

    color: var(--color-primary);

    background:
      rgba(29, 185, 84, .1);

    border: 1px solid
      rgba(29, 185, 84, .2);

    border-radius: 20px;
  }

  .ecotrack-preview strong {
    margin-top: 1.25rem;

    font-size: 2.4rem;

    letter-spacing: -.05em;
  }

  .ecotrack-preview > span {
    margin-top: .4rem;

    color: var(--color-primary);

    font-weight: 700;
  }


  .preview-cards {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: .6rem;

    width: 85%;

    margin-top: 3rem;
  }

  .preview-cards div {
    height: 110px;

    background:
      var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);
  }


  /* CONTENT */

  .project-content {
    padding: 2rem;

    max-width: 600px;
  }

  .project-meta {
    display: flex;

    align-items: center;

    gap: .75rem;

    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: .68rem;

    text-transform: uppercase;
  }

  .project-number {
    color: var(--color-primary);

    font-weight: 700;
  }

  .project-status {
    display: inline-block;

    margin-top: 1.5rem;

    padding: .35rem .65rem;

    color: var(--color-primary);

    background:
      rgba(29, 185, 84, .08);

    border: 1px solid
      rgba(29, 185, 84, .15);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: .65rem;

    font-weight: 700;
  }

  .project-content h3 {
    margin-top: .8rem;

    font-size: clamp(
      2.5rem,
      5vw,
      4rem
    );

    letter-spacing: -.06em;

    line-height: 1;
  }

  .project-subtitle {
    margin-top: .75rem;

    color: var(--color-text-secondary);

    font-size: var(--text-lg);

    line-height: 1.5;
  }

  .project-description {
    margin-top: 1.25rem;

    color: var(--color-text-muted);

    line-height: 1.8;
  }


  /* TECHNOLOGIES */

  .project-technologies {
    display: flex;

    flex-wrap: wrap;

    gap: .45rem;

    margin-top: 1.5rem;
  }

  .project-technologies span {
    padding: .35rem .6rem;

    color: var(--color-text-secondary);

    background: var(--color-background);

    border: 1px solid var(--color-border);

    border-radius: 999px;

    font-family: var(--font-mono);

    font-size: .65rem;
  }


  /* ACTIONS */

  .project-actions {
    display: flex;

    flex-wrap: wrap;

    gap: .75rem;

    margin-top: 2rem;
  }

  .primary-button,
  .github-link {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: .5rem;

    min-height: 45px;

    padding: .7rem 1rem;

    border-radius: var(--radius-md);

    font-size: var(--text-sm);

    font-weight: 700;
  }

  .primary-button {
    color: var(--color-black);

    background: var(--color-primary);
  }

  .github-link {
    color: var(--color-text);

    border: 1px solid var(--color-border);
  }

  .github-link:hover {
    color: var(--color-primary);

    border-color: var(--color-primary);
  }


  /* ALL PROJECTS */

  .all-projects {
    display: flex;

    justify-content: center;

    margin-top: 2.5rem;
  }

  .all-projects a {
    display: inline-flex;

    align-items: center;

    gap: .5rem;

    color: var(--color-text-secondary);

    font-size: var(--text-sm);

    font-weight: 700;

    border-bottom: 1px solid
      var(--color-border);

    padding-bottom: .3rem;

    transition:
      color .2s ease,
      border-color .2s ease;
  }

  .all-projects a:hover {
    color: var(--color-primary);

    border-color: var(--color-primary);
  }


  /* RESPONSIVE */

  @media (max-width: 900px) {

    .header-content {
      grid-template-columns: 1fr;

      gap: 1.5rem;
    }

    .featured-project {
      grid-template-columns: 1fr;
    }

  }


  @media (max-width: 600px) {

    .projects-preview {
      padding-block: var(--space-16);
    }

    .project-content {
      padding: 1.25rem;
    }

    .ecotrack-preview {
      min-height: 350px;

      padding: 2.5rem 1rem;
    }

    .preview-cards {
      width: 100%;

      margin-top: 2rem;
    }

    .preview-cards div {
      height: 75px;
    }

    .project-actions {
      flex-direction: column;
    }

    .primary-button,
    .github-link {
      width: 100%;
    }

  }

</style>