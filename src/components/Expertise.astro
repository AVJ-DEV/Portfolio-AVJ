---
import {
  Code2,
  Smartphone,
  Server,
  Database,
  Wrench,
  GraduationCap,
  ArrowUpRight,
} from "lucide-astro";

import { expertiseCategories } from "../data/expertise";

const icons = [
  Code2,
  Smartphone,
  Server,
  Database,
  Wrench,
  GraduationCap,
];
---

<section
  class="expertise-section"
  id="expertise"
>

  <div class="container">

    <div class="expertise-heading">

      <div class="section-eyebrow">
        <span></span>
        MON EXPERTISE
      </div>

      <div class="heading-grid">

        <h2>
          Des compétences
          techniques au service
          de projets concrets.
        </h2>

        <p>
          Je développe progressivement mon expertise
          à travers des projets pratiques, le développement
          d'applications et la transmission des connaissances
          informatiques.
        </p>

      </div>

    </div>


    <div class="expertise-grid">

      {
        expertiseCategories.map((category, index) => {

          const Icon = icons[index];

          return (

            <article class="expertise-card">

              <div class="card-top">

                <div class="expertise-icon">
                  <Icon size={22} strokeWidth={1.8} />
                </div>

                <span class="card-number">
                  0{index + 1}
                </span>

              </div>


              <h3>
                {category.title}
              </h3>

              <p class="category-description">
                {category.description}
              </p>


              <div class="technology-list">

                {
                  category.technologies.map((technology) => (

                    <div class="technology">

                      <div class="technology-info">

                        <strong>
                          {technology.name}
                        </strong>

                        <span>
                          {technology.level}
                        </span>

                      </div>

                      <p>
                        {technology.description}
                      </p>

                    </div>

                  ))
                }

              </div>

            </article>

          );
        })
      }

    </div>


    <div class="expertise-footer">

      <div>

        <span class="footer-label">
          APPROCHE
        </span>

        <p>
          J'apprends en construisant, en expérimentant
          et en transformant progressivement les idées
          en solutions numériques fonctionnelles.
        </p>

      </div>

      <a
        href="/projects"
        class="expertise-link"
      >
        Voir mes projets
        <ArrowUpRight size={17} />
      </a>

    </div>

  </div>

</section>


<style>

  .expertise-section {
    padding-block: var(--space-24);

    border-top: 1px solid var(--color-border);
  }


  /* --------------------------------
     HEADER
  -------------------------------- */

  .expertise-heading {
    margin-bottom: var(--space-12);
  }

  .section-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: .55rem;

    margin-bottom: 1rem;

    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: var(--text-xs);

    font-weight: 700;

    letter-spacing: .08em;
  }

  .section-eyebrow span {
    width: 24px;
    height: 2px;

    background: var(--color-primary);

    border-radius: 999px;
  }

  .heading-grid {
    display: grid;

    grid-template-columns:
      1.1fr .9fr;

    gap: var(--space-16);

    align-items: end;
  }

  .heading-grid h2 {
    max-width: 800px;

    font-size: clamp(
      2.5rem,
      5vw,
      4.5rem
    );

    letter-spacing: -.055em;

    line-height: 1;
  }

  .heading-grid p {
    max-width: 550px;

    color: var(--color-text-muted);

    font-size: var(--text-lg);

    line-height: 1.8;
  }


  /* --------------------------------
     GRID
  -------------------------------- */

  .expertise-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 1rem;
  }


  /* --------------------------------
     CARD
  -------------------------------- */

  .expertise-card {
    padding: 1.75rem;

    background: var(--color-surface);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-xl);

    transition:
      transform .3s ease,
      border-color .3s ease,
      box-shadow .3s ease;
  }

  .expertise-card:hover {
    transform: translateY(-4px);

    border-color:
      rgba(29, 185, 84, .35);

    box-shadow:
      0 20px 50px rgba(0, 0, 0, .08);
  }

  .card-top {
    display: flex;

    align-items: center;

    justify-content: space-between;
  }

  .expertise-icon {
    display: grid;

    place-items: center;

    width: 48px;
    height: 48px;

    color: var(--color-primary);

    background:
      rgba(29, 185, 84, .09);

    border-radius: var(--radius-md);
  }

  .card-number {
    color: var(--color-text-muted);

    font-family: var(--font-mono);

    font-size: .7rem;
  }

  .expertise-card h3 {
    margin-top: 1.5rem;

    font-size: var(--text-2xl);

    letter-spacing: -.025em;
  }

  .category-description {
    max-width: 600px;

    margin-top: .65rem;

    color: var(--color-text-muted);

    font-size: var(--text-sm);

    line-height: 1.7;
  }


  /* --------------------------------
     TECHNOLOGIES
  -------------------------------- */

  .technology-list {
    display: grid;

    gap: .5rem;

    margin-top: 1.5rem;
  }

  .technology {
    padding: .85rem 0;

    border-top: 1px solid var(--color-border);
  }

  .technology-info {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;
  }

  .technology-info strong {
    font-size: var(--text-sm);
  }

  .technology-info span {
    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: .62rem;

    font-weight: 700;

    text-transform: uppercase;
  }

  .technology p {
    margin-top: .3rem;

    color: var(--color-text-muted);

    font-size: .78rem;

    line-height: 1.6;
  }


  /* --------------------------------
     FOOTER
  -------------------------------- */

  .expertise-footer {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 2rem;

    margin-top: 1rem;

    padding: 2rem;

    background:
      linear-gradient(
        135deg,
        rgba(29, 185, 84, .09),
        var(--color-surface)
      );

    border: 1px solid
      rgba(29, 185, 84, .15);

    border-radius: var(--radius-xl);
  }

  .footer-label {
    color: var(--color-primary);

    font-family: var(--font-mono);

    font-size: .65rem;

    font-weight: 700;

    letter-spacing: .08em;
  }

  .expertise-footer p {
    max-width: 700px;

    margin-top: .5rem;

    color: var(--color-text-muted);

    line-height: 1.7;
  }

  .expertise-link {
    display: inline-flex;

    align-items: center;

    gap: .5rem;

    flex-shrink: 0;

    min-height: 44px;

    padding: .7rem 1rem;

    color: var(--color-black);

    background: var(--color-primary);

    border-radius: var(--radius-md);

    font-size: var(--text-sm);

    font-weight: 700;

    transition:
      transform .2s ease;
  }

  .expertise-link:hover {
    transform: translateY(-2px);
  }


  /* --------------------------------
     RESPONSIVE
  -------------------------------- */

  @media (max-width: 900px) {

    .heading-grid {
      grid-template-columns: 1fr;

      gap: 1.5rem;
    }

  }


  @media (max-width: 700px) {

    .expertise-section {
      padding-block: var(--space-16);
    }

    .expertise-grid {
      grid-template-columns: 1fr;
    }

    .expertise-footer {
      align-items: flex-start;

      flex-direction: column;
    }

    .expertise-link {
      width: 100%;

      justify-content: center;
    }

  }


  @media (max-width: 480px) {

    .expertise-card {
      padding: 1.25rem;
    }

    .heading-grid h2 {
      font-size: 2.5rem;
    }

  }

</style>